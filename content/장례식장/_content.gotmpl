{{ $d := index site.Data.regions "장례식장" }}
{{ range $d.pages }}
  {{ $title := .title }}
  {{ $description := .description }}
  {{ if and .sigungu (ne .sido .sigungu) }}
    {{ $title = printf "%s %s" .sido $title }}
    {{ $description = printf "%s %s" .sido $description }}
  {{ end }}
  {{ $.AddPage (dict "kind" "page" "path" .relpath "title" $title "description" $description "params" .) }}
{{ end }}
